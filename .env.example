# Payline Financial Intelligence Engine — Environment Configuration
# Copy this file to .env and configure with your credentials:
# cp .env.example .env

# Google Gemini API Key for CFO Intelligence & Conversational Advisory
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Session Encryption Secret Key
SECRET_KEY=generate_a_secure_random_key_here

# Server Port (Default: 5000)
PORT=5000
